[Unit]
Description=Foreman enqueue timer for project %i

[Timer]
OnBootSec=5min
# Less frequent than tick — producers are cheaper checks but
# typically less time-sensitive. Override per-project via a drop-in at
# ~/.config/systemd/user/foreman-enqueue@<project>.timer.d/override.conf
OnUnitInactiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
