# Igor environment -- copy to .env in this same directory and edit.
#
#   cp .env.example .env
#   chmod 600 .env
#
# bin/tick.sh sources .env from $IGOR_HOME (the repo root) on every
# run. Same file is used for local dev and systemd-managed installs.

# Anthropic API key (NOT the Claude Max OAuth token).
#
# Create in the Anthropic Console (https://console.anthropic.com).
# Use a dedicated key for Igor so usage is itemized separately from
# any other tooling. Set a hard spending limit on the key so a
# pathological tick can't drain the account.
ANTHROPIC_API_KEY=

# Model used for every tick. Pin a specific model ID rather than an
# alias so version drift doesn't surprise the harness. Defaults are
# nothing -- this must be set explicitly.
#
# Sensible choices:
#   claude-sonnet-4-6           # default working model -- balanced cost/capability
#   claude-opus-4-7             # premium -- complex reasoning, ambiguous tasks
#   claude-haiku-4-5-20251001   # cheap/fast -- light tasks only
IGOR_MODEL=claude-sonnet-4-6

# Forgejo instance.
FORGEJO_URL=https://git.sherver.org

# Bot user's API token. The bot's identity is derived from this token
# (GET /api/v1/user). Needs scopes for: read:user, repository (issue,
# PR, comment, label, assign), and push access on every target repo.
FORGEJO_TOKEN=

# Optional. SSH endpoint used for clone-on-demand. Defaults to the
# host extracted from FORGEJO_URL. Override if SSH is on a non-default
# host or port.
# FORGEJO_SSH_HOST=

# Optional. Per-tick Claude timeout (passed to `timeout`). Default 60m.
# IGOR_TIMEOUT=60m

# Optional. Where Igor clones repos when they're missing locally.
# Default ~/Code.
# IGOR_CODE_ROOT=

# Optional. Where worktrees and the global lock live.
# Default ~/.local/state/igor.
# IGOR_STATE_DIR=
