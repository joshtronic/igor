# Tick environment -- template seeded into ~/.config/tick/.env by
# bin/install.sh. To bootstrap manually:
#
#   mkdir -p ~/.config/tick
#   cp .env.example ~/.config/tick/.env
#   chmod 600 ~/.config/tick/.env
#
# bin/tick.sh sources ~/.config/tick/.env on every run.

# Claude Max OAuth token. Generate with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Forgejo instance.
FORGEJO_URL=https://git.sherver.org

# Bot user's API token. Needs scopes for: issues, pulls, comments,
# labels, write access on target repos.
FORGEJO_TOKEN=

# Optional. The Forgejo user the bot acts as. Defaults to "agent".
# BOT_USER=agent

# Optional. Where worktrees and locks live.
# Defaults to ~/.local/state/tick.
# TICK_STATE_DIR=
