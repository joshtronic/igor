# Tick environment -- template seeded into ~/.config/tick/.env by
# bin/install.sh. To bootstrap manually:
#
#   mkdir -p ~/.config/tick
#   cp .env.example ~/.config/tick/.env
#   chmod 600 ~/.config/tick/.env
#
# bin/tick.sh sources ~/.config/tick/.env on every run.

# Claude Max OAuth token. Generate with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Forgejo instance.
FORGEJO_URL=https://git.sherver.org

# Bot user's API token. The bot's identity is derived from this token
# (GET /api/v1/user). Needs scopes for: read:user, repository (issue,
# PR, comment, label, assign), and push access on every target repo.
FORGEJO_TOKEN=

# Optional. SSH endpoint used for clone-on-demand. Defaults to the
# host extracted from FORGEJO_URL. Override if SSH is on a non-default
# host or port.
# FORGEJO_SSH_HOST=

# Optional. Per-tick Claude timeout (passed to `timeout`). Default 60m.
# TICK_TIMEOUT=60m

# Optional. Where Tick clones repos when they're missing locally.
# Default ~/Code.
# TICK_CODE_ROOT=

# Optional. Where worktrees and the global lock live.
# Default ~/.local/state/tick.
# TICK_STATE_DIR=
