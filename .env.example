# Tick environment -- copy to .env and fill in.
#
#   cp .env.example .env
#   chmod 600 .env
#
# The .env file is gitignored. Required by bin/tick.sh and the
# systemd units (they load this via EnvironmentFile=).

# Claude Max OAuth token. Generate with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Forgejo instance.
FORGEJO_URL=https://git.sherver.org

# Bot user's API token. Needs scopes for: issues, pulls, comments,
# labels, write access on target repos.
FORGEJO_TOKEN=

# Optional. The Forgejo user the bot acts as. Defaults to "agent".
# BOT_USER=agent

# Optional. Where worktrees and locks live.
# Defaults to ~/.local/state/tick.
# TICK_STATE_DIR=
